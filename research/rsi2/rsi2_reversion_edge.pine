//@version=5
// =====================================================================================
// RSI(2) Reversion Edge  —  oversold mean reversion inside a long-term uptrend
//
// Validated 2000-2026 on 14 assets. Edge confirmed on equity indices and large caps
// (~4x the unconditional drift per day held, p < 0.01 vs matched random entries).
// NO tradeable edge on FX majors — the signal is ~11 bps/trade gross on GBPUSD and
// turns negative at a 10 bps round trip. Use this on indices/ETFs/equities.
//
// RULE
//   BUY  : RSI(2) < 10  AND  Close > SMA(200)      -> signal at the close of that bar
//   SELL : RSI(2) > 65  OR   10 bars elapsed       -> signal at the close of that bar
//
// Use on DAILY bars. Signals print on the close of the bar (confirmed, not repainting
// once the bar closes). Fill assumption in the backtest was market-on-close.
// =====================================================================================

indicator("RSI(2) Reversion Edge", shorttitle="RSI2 Edge", overlay=true, max_labels_count=500)

// ---------------------------------------------------------------- inputs
grpS = "Signal rules"
rsiLen    = input.int(2,   "RSI length",            minval=1, maxval=50,   group=grpS)
buyLvl    = input.int(10,  "Buy below RSI",         minval=1, maxval=50,   group=grpS)
sellLvl   = input.int(65,  "Sell above RSI",        minval=50, maxval=99,  group=grpS)
trendLen  = input.int(200, "Trend SMA length",      minval=20, maxval=400, group=grpS)
useTrend  = input.bool(true,"Require Close > trend SMA", group=grpS,
     tooltip="This gate is what makes the edge worth trading. Without it the same trigger earns more per trade but with a 24% drawdown and a Sharpe of 0.11.")
maxHold   = input.int(10,  "Max bars held (time stop)", minval=1, maxval=60, group=grpS)

grpV = "Display"
showTrend = input.bool(true,  "Plot trend SMA",            group=grpV)
showZone  = input.bool(true,  "Shade while in position",   group=grpV)
showLbls  = input.bool(true,  "BUY / SELL labels",         group=grpV)
showStats = input.bool(true,  "Stats table",               group=grpV)
alertOn   = input.bool(true,  "Enable alerts",             group=grpV)

grpC = "Costs"
costBps   = input.float(5.0, "Round-trip cost (bps)", minval=0, maxval=200, step=0.5, group=grpC,
     tooltip="Charged once per completed trade in the stats table. The backtest used 5 bps.")

// ---------------------------------------------------------------- indicators
r      = ta.rsi(close, rsiLen)
trend  = ta.sma(close, trendLen)
upTrend = not useTrend or close > trend

// ---------------------------------------------------------------- state machine
var bool  inPos    = false
var int   barsHeld = 0
var float entryPx  = na
var int   entryBar = na

// evaluated on every bar; on the last (live) bar this reflects the running price
entryTrigger = r < buyLvl and upTrend
exitTrigger  = r > sellLvl

buySignal  = not inPos and entryTrigger
sellSignal = false

if inPos
    barsHeld += 1
    if exitTrigger or barsHeld >= maxHold
        sellSignal := true

// ---------------------------------------------------------------- trade log
var int   nTrades = 0
var int   nWins   = 0
var float sumRet  = 0.0
var float sumBars = 0.0
var float worst   = 0.0

if sellSignal
    ret = (close - entryPx) / entryPx * 100.0 - costBps / 100.0
    nTrades += 1
    nWins   += ret > 0 ? 1 : 0
    sumRet  += ret
    sumBars += barsHeld
    worst   := math.min(worst, ret)
    inPos    := false
    barsHeld := 0
    entryPx  := na

if buySignal
    inPos    := true
    barsHeld := 1
    entryPx  := close
    entryBar := bar_index

// ---------------------------------------------------------------- plots
cBuy   = color.new(#0ca30c, 0)
cSell  = color.new(#d03b3b, 0)
cTrend = color.new(#2a78d6, 0)
cZone  = color.new(#2a78d6, 88)

plot(showTrend ? trend : na, "Trend SMA", color=cTrend, linewidth=2)
bgcolor(showZone and inPos ? cZone : na, title="In position")

plotshape(showLbls and buySignal,  title="BUY",  location=location.belowbar,
     style=shape.labelup,   color=cBuy,  textcolor=color.white, text="BUY",  size=size.small)
plotshape(showLbls and sellSignal, title="SELL", location=location.abovebar,
     style=shape.labeldown, color=cSell, textcolor=color.white, text="SELL", size=size.small)

// dots for every oversold bar that the trend gate rejected — shows what the filter removed
plotshape(r < buyLvl and not upTrend, title="Oversold, trend gate rejected",
     location=location.belowbar, style=shape.circle, color=color.new(#898781, 35), size=size.tiny)

// ---------------------------------------------------------------- stats table
if showStats and barstate.islast
    avgRet  = nTrades > 0 ? sumRet / nTrades : 0.0
    winPct  = nTrades > 0 ? nWins / nTrades * 100.0 : 0.0
    avgBars = nTrades > 0 ? sumBars / nTrades : 0.0
    perDay  = avgBars > 0 ? avgRet / avgBars : 0.0
    t = table.new(position.top_right, 2, 9, border_width=1,
         frame_color=color.new(color.gray, 60), border_color=color.new(color.gray, 70))
    table.cell(t, 0, 0, "RSI2 Edge", bgcolor=color.new(#2a78d6, 15), text_color=color.white,
         text_size=size.small, text_halign=text.align_left)
    table.cell(t, 1, 0, timeframe.period, bgcolor=color.new(#2a78d6, 15),
         text_color=color.white, text_size=size.small)
    rowk = array.from("Trades", "Win rate", "Avg / trade", "Avg hold", "Per day held", "Worst trade", "Total", "State")
    rowv = array.from(
         str.tostring(nTrades),
         str.tostring(winPct, "#.0") + "%",
         str.tostring(avgRet, "#.00") + "%",
         str.tostring(avgBars, "#.0") + " bars",
         str.tostring(perDay, "#.00") + "%",
         str.tostring(worst, "#.0") + "%",
         str.tostring(sumRet, "#.0") + "%",
         inPos ? "LONG " + str.tostring(barsHeld) + "/" + str.tostring(maxHold) : "flat")
    for i = 0 to 7
        table.cell(t, 0, i + 1, array.get(rowk, i), text_size=size.small,
             text_halign=text.align_left, text_color=color.gray)
        vc = i == 7 ? (inPos ? cBuy : color.gray) : (i == 5 ? cSell : chart.fg_color)
        table.cell(t, 1, i + 1, array.get(rowv, i), text_size=size.small,
             text_halign=text.align_right, text_color=vc)

// ---------------------------------------------------------------- alerts
alertcondition(buySignal,  "RSI2 Edge — BUY",  "RSI(2) oversold in uptrend. BUY at close.")
alertcondition(sellSignal, "RSI2 Edge — SELL", "RSI(2) exit or time stop. SELL at close.")

if alertOn and buySignal
    alert("RSI2 Edge BUY " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
if alertOn and sellSignal
    alert("RSI2 Edge SELL " + syminfo.ticker + " @ " + str.tostring(close, format.mintick), alert.freq_once_per_bar_close)
