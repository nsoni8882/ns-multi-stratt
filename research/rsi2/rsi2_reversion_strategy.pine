//@version=5
// =====================================================================================
// RSI(2) Reversion Edge — STRATEGY version, for TradingView's Strategy Tester
// Same rule as the indicator. Load this to reproduce the backtest numbers yourself.
//
//   BUY  : RSI(2) < 10  AND  Close > SMA(200)   -> market-on-close entry
//   SELL : RSI(2) > 65  OR   10 bars elapsed    -> market-on-close exit
//
// Use DAILY bars on an index, ETF or large-cap equity. Set Properties > Commission to
// 0.025% per side (= 5 bps round trip) and Slippage to 0 to match the published test.
// Expected on SPY daily, full history: ~210 trades, ~81% winners, ~+0.62% per trade.
// =====================================================================================

strategy("RSI(2) Reversion Edge [strategy]", shorttitle="RSI2 Edge S", overlay=true,
     initial_capital=100000, default_qty_type=strategy.percent_of_equity, default_qty_value=100,
     commission_type=strategy.commission.percent, commission_value=0.025,
     process_orders_on_close=true, calc_on_every_tick=false)

rsiLen   = input.int(2,   "RSI length",            minval=1,  maxval=50)
buyLvl   = input.int(10,  "Buy below RSI",         minval=1,  maxval=50)
sellLvl  = input.int(65,  "Sell above RSI",        minval=50, maxval=99)
trendLen = input.int(200, "Trend SMA length",      minval=20, maxval=400)
useTrend = input.bool(true, "Require Close > trend SMA")
maxHold  = input.int(10,  "Max bars held",         minval=1,  maxval=60)

startY   = input.int(2000, "Backtest from year", minval=1980, maxval=2100)
inWindow = year >= startY

r       = ta.rsi(close, rsiLen)
trend   = ta.sma(close, trendLen)
upTrend = not useTrend or close > trend

plot(trend, "Trend SMA", color=color.new(#2a78d6, 0), linewidth=2)
bgcolor(strategy.position_size > 0 ? color.new(#2a78d6, 88) : na, title="In position")

if inWindow and strategy.position_size == 0 and r < buyLvl and upTrend
    strategy.entry("Long", strategy.long, comment="BUY")

if strategy.position_size > 0
    held = bar_index - strategy.opentrades.entry_bar_index(strategy.opentrades - 1)
    if r > sellLvl or held >= maxHold
        strategy.close("Long", comment="SELL")
